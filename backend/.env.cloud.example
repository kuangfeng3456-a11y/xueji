# 华为云开通参数模板
# 复制为 backend/.env.cloud 后填写；该文件已被 .gitignore 忽略，请勿提交
# 填好后执行：python scripts/provision_cloud.py --dry-run

# ===== 凭证（IAM → 我的凭证 → 访问密钥）=====
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
# 我的凭证 → API 凭证 → 项目列表，复制对应区域的项目 ID
CLOUD_PROJECT_ID=

# ===== 区域（如华北-北京四 cn-north-4）=====
CLOUD_REGION=cn-north-4
CLOUD_AVAILABILITY_ZONE=cn-north-4a

# ===== 网络（VPC 控制台 → VPC / 子网 / 安全组）=====
CLOUD_VPC_ID=
CLOUD_SUBNET_ID=
CLOUD_SECURITY_GROUP_ID=

# ===== RDS（脚本自动创建最小 MySQL 8.0 单机规格）=====
RDS_NAME=xueji-mysql
RDS_VOLUME_SIZE=40
# 可选：指定规格编码；留空自动查询最小规格
RDS_FLAVOR=
# 可选：留空由脚本随机生成强密码
RDS_PASSWORD=

# ===== DCS Redis（必填规格编码）=====
DCS_NAME=xueji-redis
DCS_CAPACITY=1
# DCS 控制台创建实例页 → Redis 5.0 → 1GB → 规格编码
DCS_SPEC_CODE=
# 可选：留空由脚本随机生成强密码
DCS_PASSWORD=