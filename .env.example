# 复制为 .env 后按需修改；不配置 LLM 时系统自动使用规则引擎兜底
SECRET_KEY=xueji-dev-secret-please-change

# docker-compose 使用的数据库口令占位（compose 会在缺失时拒绝启动）
# 请改成自己的强口令，不要复用示例值
# DB_ROOT_PASSWORD=
# DB_PASSWORD=
# DB_USER=xueji
# DB_NAME=xueji

# 本地默认使用 SQLite；生产建议改为 RDS MySQL
# DATABASE_URL=mysql+pymysql://xueji:xuejipass@your-rds-host:3306/xueji?charset=utf8mb4
DATABASE_URL=sqlite:///./xueji.db

# 配置后自动启用 Redis 缓存、限流与排行
# REDIS_URL=redis://your-dcs-host:6379/0
REDIS_URL=

# ===== 华为云 RDS MySQL =====
# 设置 RDS_HOST 后会自动拼接 DATABASE_URL；也可直接设置 DATABASE_URL
# RDS_HOST=your-rds-host
# RDS_PORT=3306
# RDS_USER=xueji
# RDS_PASSWORD=your-password
# RDS_DATABASE=xueji
# RDS_SSL_CA=/path/to/rds-ca.pem

# ===== 华为云 DCS Redis =====
# 设置 REDIS_HOST 后会自动拼接 REDIS_URL（SSL 用 REDIS_SSL=true）
# REDIS_HOST=your-dcs-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password
# REDIS_DB=0
# REDIS_SSL=false
# REDIS_SSL_CA=/path/to/dcs-ca.pem

# ===== 华为云凭证与资源（仅开通脚本使用，请勿提交）=====
# HUAWEICLOUD_SDK_AK=
# HUAWEICLOUD_SDK_SK=
# CLOUD_PROJECT_ID=
# CLOUD_REGION=cn-north-4
# CLOUD_AVAILABILITY_ZONE=cn-north-4a
# CLOUD_VPC_ID=
# CLOUD_SUBNET_ID=
# CLOUD_SECURITY_GROUP_ID=
# RDS_FLAVOR=
# RDS_NAME=xueji-mysql
# RDS_VOLUME_SIZE=40
# DCS_SPEC_CODE=
# DCS_NAME=xueji-redis
# DCS_CAPACITY=1

# DeepSeek（推荐）：四个智能体、知识点抽取与语音问答全部接入
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-key
# LLM_MODEL=deepseek-chat

# ===== 第三方查题题库（可选，柠檬题库 / LIKE知识库 同款查题接口）=====
# 文档: https://docs.lemtk.xyz/get-started.html
# 供应商选择：lemtk(柠檬题库，默认) / gomooc(ZERO 网课题库)
# QBANK_PROVIDER=lemtk
# 主供应商给不出答案（额度用尽 / Token 失效 / 超时 / 暂无答案）时自动回落的备用供应商，留空则不降级
# QBANK_FALLBACK_PROVIDER=

# ---- ZERO 网课题库（QBANK_PROVIDER=gomooc 时启用）----
# 接口: GET /api.php?token=<token>&question=<题干>，返回标准 JSON
# 注意：必须带 token；额度用尽返回 code 429（剩余次数: 0）
# QBANK_GOMOOC_BASE_URL=https://api.gomooc.net
# QBANK_GOMOOC_ENDPOINT=/api.php
# QBANK_GOMOOC_TOKEN=your-token
# QBANK_GOMOOC_MERGE_OPTIONS=true

# ---- 柠檬题库（QBANK_PROVIDER=lemtk 时启用）----
# 文档: https://docs.lemtk.xyz/get-started.html
# 仓库: https://github.com/destoryD/chaoxing-api
# 接口形态：按题干 + 选项查答案；不支持按知识点枚举题目。
#   普通查询 POST /api/v1/cx    Token 可选（免费、限流）
#   高级查询 POST /api/v1/mcx  Token 必填（命中率更高）
#   余额查询 GET /api/v1/balance?email=&token=
# QBANK_BASE_URL=https://api.lemtk.xyz
# 备用域名: https://api.vanse.top
# QBANK_TOKEN=
# QBANK_EMAIL=
# QBANK_MODE=cx
# QBANK_TIMEOUT=8

# ===== 通用外部出题接口（可选，按知识点返回题目；与上面的查题接口互不影响）=====
# 由服务端调用；题目须来自你有权使用的题库服务。
# API 接收 POST JSON：
# {"exam_name":"...","knowledge_point":"...","module":"...","count":2,
#  "language":"zh|en|auto","question_type":"single_choice"}
# 返回 {"questions":[{"question":"题干","options":["A","B","C","D"],
#  "answer_index":0,"explanation":"解析","kp_name":"知识点"}]}
# 只有通过题型、答案下标和学科语言校验的题才会进入练习；失败时自动回退模型/规则题。
# QUESTION_BANK_API_URL=https://your-provider.example/api/questions
# QUESTION_BANK_API_KEY=your-server-side-key
# QUESTION_BANK_TIMEOUT=8

# ===== 自建题库 tikuAdapter（推荐，课程名 = 知识点名）=====
# 部署：下载 Release 二进制 / docker run -p 8060:8060，源码见 https://github.com/DokiDoki1103/tikuAdapter
# 灌库：python backend/scripts/seed_tiku_adapter.py
# 出题时按知识点名查 course_name，题库里「定积分」这门课下的题只会出给「定积分」。
# 留空则跳过该题源，回退模型生成 / 内置题库。
# TIKU_ADAPTER_URL=http://127.0.0.1:8060
# TIKU_ADAPTER_USER=admin
# TIKU_ADAPTER_PASSWORD=123456
# TIKU_ADAPTER_TIMEOUT=6

# 或华为云盘古 / ModelArts 等兼容 OpenAI Chat Completions 的服务
# LLM_BASE_URL=https://your-llm-endpoint/v1
# LLM_API_KEY=your-key
# LLM_MODEL=pangu

# ===== 模型档位路由与调用审计（v2.0 文档 6.4）=====
# 三档可分别指向不同模型；未配置的档位自动回落到 LLM_MODEL
# LLM_TIER_FAST=deepseek-chat
# LLM_TIER_GENERAL=deepseek-chat
# LLM_TIER_REASONING=deepseek-reasoner
# 每用户每日 token 预算，0 表示不限制；超限自动降级为规则文案并在 llm_calls 标注
# LLM_DAILY_TOKEN_BUDGET=0
# llm_calls 审计开关（默认开启；写库失败不会影响业务）
# LLM_AUDIT_ENABLED=true

# 错题图片与强制学习见证的存储目录（可替换为 OBS 挂载路径）
# UPLOAD_DIR=./backend/uploads

# ===== 华为云 AI 与存储能力（services/cloud_services.py；均为可选，缺配置自动降级）=====
# OCR 端点覆盖（默认 https://ocr.{region}.myhuaweicloud.com）
# OCR_ENDPOINT=
# SIS 端点覆盖（默认 https://sis.{region}.myhuaweicloud.com）
# SIS_ENDPOINT=
# 见证缩略图对象存储（仅用户主动开启云端备份时使用；原图始终留在浏览器本地）
# OBS_ENDPOINT=
# OBS_BUCKET=
# OBS_ACCESS_KEY=
# OBS_SECRET_KEY=
# 缩略图保留天数（obs_configure_lifecycle 使用，到期云端自动删除）
# OBS_WITNESS_RETENTION_DAYS=7
# DEW/CSMS 凭据托管（kms_get_secret 按名称读取；读到的明文不进日志与接口层）
# DEW_KEYSTORE_ID=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
FRONTEND_DIST=../frontend/dist

# ---- 演示与种子数据（商用部署请留空）----
# 写在登录页的演示账号提示，格式 "用户名 / 密码"。留空则登录页不展示任何账号。
# DEMO_HINT=demo / your-password
# 种子脚本创建的 demo 账号与演示班级同学口令。留空则随机生成并只在输出里打印一次。
# SEED_DEMO_PASSWORD=
