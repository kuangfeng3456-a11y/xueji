<Slide style={{ width: 1280, height: 720, padding: 60, background: '#0B1521' }}>
    <Box style={{ gap: 8 }}>
        <Text style={{ fontSize: 14, color: '#8FBCE4', letterSpacing: 2 }}>04 · 华为云与落地</Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>方案组件与华为云服务逐项对应</Text>
        <Box style={{ width: '100%', height: 1, background: '#3A5A78', marginTop: 6 }} />
    </Box>
    <Box style={{ background: '#232C37', borderRadius: 8, marginTop: 28, overflow: 'hidden', flex: 1 }}>
        <Box style={{ flexDirection: 'row', background: '#3A5CBC', padding: '14px 24px', gap: 16 }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF', width: 190 }}>方案组件</Text>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF', width: 300 }}>华为云服务</Text>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF', flex: 1 }}>当前状态</Text>
        </Box>
        <Box style={{ flexDirection: 'row', padding: '14px 24px', gap: 16, borderBottom: '1px solid #2A3542', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', width: 190 }}>业务数据库</Text>
            <Text style={{ fontSize: 16, color: '#63A7D4', width: 300 }}>RDS for MySQL</Text>
            <Text style={{ fontSize: 16, color: '#C9CCCE', flex: 1 }}>实例已创建，24 张表迁移验证通过；演示环境自动降级 SQLite</Text>
        </Box>
        <Box style={{ flexDirection: 'row', padding: '14px 24px', gap: 16, borderBottom: '1px solid #2A3542', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', width: 190 }}>缓存与限流</Text>
            <Text style={{ fontSize: 16, color: '#63A7D4', width: 300 }}>DCS for Redis</Text>
            <Text style={{ fontSize: 16, color: '#C9CCCE', flex: 1 }}>主备实例已创建；连接不可达时自动降级内存缓存</Text>
        </Box>
        <Box style={{ flexDirection: 'row', padding: '14px 24px', gap: 16, borderBottom: '1px solid #2A3542', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', width: 190 }}>资料与错题图片</Text>
            <Text style={{ fontSize: 16, color: '#63A7D4', width: 300 }}>OBS 对象存储</Text>
            <Text style={{ fontSize: 16, color: '#C9CCCE', flex: 1 }}>存储配置就绪，上传路径可切换为 OBS 挂载</Text>
        </Box>
        <Box style={{ flexDirection: 'row', padding: '14px 24px', gap: 16, borderBottom: '1px solid #2A3542', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', width: 190 }}>大模型</Text>
            <Text style={{ fontSize: 16, color: '#63A7D4', width: 300 }}>盘古 / ModelArts</Text>
            <Text style={{ fontSize: 16, color: '#C9CCCE', flex: 1 }}>OpenAI 兼容网关即插即用；未配 Key 时全链路规则兜底</Text>
        </Box>
        <Box style={{ flexDirection: 'row', padding: '14px 24px', gap: 16, borderBottom: '1px solid #2A3542', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', width: 190 }}>AI 编码</Text>
            <Text style={{ fontSize: 16, color: '#63A7D4', width: 300 }}>码道 CodeArts</Text>
            <Text style={{ fontSize: 16, color: '#C9CCCE', flex: 1 }}>需求拆解、接口与测试全程辅助，保留项目索引与会话记录</Text>
        </Box>
        <Box style={{ flexDirection: 'row', padding: '14px 24px', gap: 16, alignItems: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', width: 190 }}>部署与扩容</Text>
            <Text style={{ fontSize: 16, color: '#63A7D4', width: 300 }}>ECS + Docker → CCE + ELB</Text>
            <Text style={{ fontSize: 16, color: '#C9CCCE', flex: 1 }}>初赛 Compose 一键启动；总决赛平滑切换容器集群</Text>
        </Box>
    </Box>
    <Box style={{ background: '#63A7D4', borderRadius: 8, padding: '16px 28px', marginTop: 24 }}>
        <Text style={{ fontSize: 19, color: '#FFFFFF' }}><span style={{ fontWeight: 'bold' }}>部署弹性：</span>本地零配置可跑，云上一键切换——完整降级链路保证任何环境都能演示</Text>
