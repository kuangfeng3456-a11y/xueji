            <Text style={{ fontSize: 15, color: '#C9CCCE', lineHeight: 1.45 }}>按倒计时与优先级排每日三个微任务</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#63A7D4' }}>→</Text>
        <Box style={{ background: '#232C37', borderRadius: 8, padding: 18, width: 163, height: 190, justifyContent: 'flex-start' }}>
